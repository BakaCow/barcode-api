# Copy this file to runtime.env. Replace placeholders with independently
# generated secrets before starting. Never commit runtime.env.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure either BARCODE_API_KEY or BARCODE_API_CUSTOMERS (or both).
BARCODE_API_CUSTOMERS='[{"id":"shop-a","keys":["REPLACE_CUSTOMER_KEY"],"requests_per_minute":600,"max_concurrent":2}]'
BARCODE_ADMIN_KEY=REPLACE_ADMIN_KEY
BARCODE_GLOBAL_CONCURRENT=4
BARCODE_REQUEST_LOGGING=true
