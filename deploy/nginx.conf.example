# Install inside your nginx http{} configuration after replacing the domain
# and certificate paths. The API's port must remain private/loopback-only.
# Do not add API keys or decoded values to access logs.
log_format barcode_safe '$time_iso8601 $status $request_time $upstream_response_time';
# Empty keys are not rate-accounted. Static /scan/ assets can therefore install
# atomically for several tills sharing an IP without consuming the API bucket.
map $uri $barcode_api_limit_key {
    default "";
    ~^/v1(?:/|$) $binary_remote_addr;
}
limit_req_zone $barcode_api_limit_key zone=barcode_api_edge:10m rate=20r/s;

server {
    listen 80;
    server_name scanner.example.com;
    return 308 https://scanner.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name scanner.example.com;
    ssl_certificate /etc/letsencrypt/live/scanner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scanner.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/barcode-access.log barcode_safe;
    client_max_body_size 11m;
    client_body_timeout 15s;
    send_timeout 30s;
    add_header X-Content-Type-Options nosniff always;

    # Operators can query metrics over the private localhost port. Keep the
    # operator endpoint unavailable through this public virtual host.
    location = /ops/metrics {
        return 404;
    }

    location / {
        limit_req zone=barcode_api_edge burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        # Authentication/admission occur in the app before it reads uploads.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
    }
}
