  "info": {
    "description": "Read codes from images and generate QR, Code 128, EAN-13, and UPC-A images.",
    "title": "Barcode API",
    "version": "0.9.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/barcodes/generate": {
      "post": {
        "description": "Generate an image. EAN-13 and UPC-A require a valid, complete check digit.",
        "operationId": "generate_v1_barcodes_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "image/png": {},
              "image/svg+xml": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Generate"
      }
    },
    "/v1/barcodes/read": {
      "post": {
        "description": "Read PNG, JPEG, or WebP. Positions use EXIF-normalized image coordinates.",
        "operationId": "read_v1_barcodes_read_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_read_v1_barcodes_read_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Read"
      }
    },
    "/v1/formats": {
      "get": {
        "operationId": "formats_v1_formats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Formats"
      }
    },
    "/v1/pos/decode": {
      "post": {
        "description": "Decide one POS result from a stateless burst; conflicting identities are ambiguous.\n\nConfirmation defaults to two distinct images. Set confirmation_frames to 1\nto accept a single match. Identical normalized pixels never add confirmation.\nNo agreement or camera state is retained between requests.",
        "operationId": "pos_decode_v1_pos_decode_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_pos_decode_v1_pos_decode_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PosResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Pos Decode"
      }
    }
  }
}
